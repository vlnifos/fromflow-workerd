@@ -0,0 +1,64 @@
+// Copyright (c) 2026 FromFlow.
+// Licensed under the Apache 2.0 license found in the LICENSE file or at:
+//     https://opensource.org/licenses/Apache-2.0
+
+#pragma once
+
+// Multi-tenant resource limits for workerd: per-request CPU time and per-isolate V8 heap.
+//
+// Upstream workerd is single-tenant and ships no-op enforcers (NullLimitEnforcer,
+// NullIsolateLimitEnforcer in worker-factory.c++). When workerd hosts code from many owners in
+// one process, one `while(true)` stalls every worker of the process, and one heap blowup kills
+// it. These enforcers stop the offending request instead:
+//
+// - CPU: JS scopes are timed by the (vDSO) monotonic clock; a watchdog thread calls
+//   v8::Isolate::TerminateExecution() when a request's budget is spent and the thread's real
+//   CPU clock confirms it is still burning CPU. IoContext already turns the termination into
+//   the limit error (it calls requireLimitsNotExceeded()).
+// - Heap: a V8 heap limit per isolate (= per worker) plus a near-heap-limit callback that
+//   terminates the running JS and condemns the isolate: further JS in it is refused, so the
+//   process survives and the supervisor can recycle it.
+// - Buffers: ArrayBuffer backing stores live outside the V8 heap, so the heap limit does not see
+//   them. A per-isolate allocator with a byte budget refuses allocations past it (JS gets
+//   "RangeError: Array buffer allocation failed"); the isolate stays usable.
+//
+// Opt-in, read once from the environment; unset = upstream behaviour:
+//   WORKERD_TENANT_CPU_MS          CPU time per request (all enterJs() scopes of the request)
+//   WORKERD_TENANT_STARTUP_CPU_MS  CPU time for script startup, dynamic imports and the requests
+//                                  of a fresh isolate until one completes (default 1000)
+//   WORKERD_TENANT_HEAP_MB         V8 old-generation heap per isolate
+//   WORKERD_TENANT_BUFFERS_MB      ArrayBuffer memory per isolate (default: the heap limit)
+
+#include <workerd/io/limit-enforcer.h>
+
+#include <kj/memory.h>
+
+#include <cstddef>
+#include <cstdint>
+
+namespace workerd::server {
+
+struct TenantLimits {
+  // 0 = not limited.
+  int64_t cpuNs = 0;
+  int64_t startupCpuNs = 0;
+  size_t heapBytes = 0;
+  size_t bufferBytes = 0;
+
+  bool enabled() const {
+    return cpuNs > 0 || heapBytes > 0 || bufferBytes > 0;
+  }
+};
+
+// Limits from the environment, parsed once per process.
+const TenantLimits& tenantLimits();
+
+// Per-request enforcer: one per request (entrypoint), like NullLimitEnforcer.
+kj::Own<LimitEnforcer> newTenantLimitEnforcer(const TenantLimits& limits);
+
+// Per-isolate enforcer: one per isolate, like NullIsolateLimitEnforcer. `group` is the isolate
+// group the isolate will be created in: the buffer allocator must come from the same group.
+kj::Own<IsolateLimitEnforcer> newTenantIsolateLimitEnforcer(
+    const TenantLimits& limits, v8::IsolateGroup group);
+
+}  // namespace workerd::server
